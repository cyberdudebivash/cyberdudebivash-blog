# ============================================================
# CYBERDUDEBIVASH SENTINEL APEX v4.0 — Environment Variables
# ============================================================
# For local Worker development, use an untracked .dev.vars file.
# Set runtime secrets in Cloudflare Workers; pipeline secrets in GitHub Actions.
#
# This file covers the ~39 variables read via process.env in the JS/
# serverless app (api/**, fetch-live-intel.js, ai-security-intel-engine.js,
# scripts/backup-customer-data.js, scripts/restore-customer-data.js).
# It does NOT cover the separate credential domain used by the Python
# Blogger-syndication pipeline (BLOGGER_*, GROQ_API_KEY, DEEPSEEK_API_KEY,
# OPENROUTER_API_KEY, ALIENVAULT_OTX_KEY, GOOGLE_SEARCH_CONSOLE_KEY,
# TWITTER_*) — those are GitHub Actions repository secrets, set at
# GitHub → repo → Settings → Secrets and variables → Actions, never in
# the Worker or this file. See ENVIRONMENT_VARIABLE_MATRIX.md for the
# complete picture across both domains, with file:line citations for
# every variable's actual usage.
# ============================================================

# ----------------------------------------------------------
# UPSTASH REDIS (REQUIRED — the platform's only persistent datastore:
# auth, tiers, rate limiting, billing state, the entire intelligence/
# workbench API. 45 files, ~415 call sites depend on this.)
# Get from: https://console.upstash.com → Create Database → REST API
# ----------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ----------------------------------------------------------
# RAZORPAY BILLING (OPTIONAL — instant automated UPI/card/wallet checkout;
# the platform's default, preferred payment rail — see OPERATIONS.md)
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Until set, billing?action=create-razorpay-order returns 503 and the UI
# falls back to the manual UPI/Bank flow automatically.
# ----------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Webhook signing secret from: Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ----------------------------------------------------------
# GUMROAD (OPTIONAL — global software downloads, standalone rule packs,
# license key fulfillment; secondary rail alongside Razorpay)
# Gumroad's Ping webhook does not sign its payload, so this is a shared
# secret placed in the webhook URL itself, not an HMAC key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure at: Gumroad → Settings → Advanced → Webhooks, with URL:
#   https://blog.cyberdudebivash.in/api/v1/billing/gumroad-webhook?secret=<this value>
# ----------------------------------------------------------
GUMROAD_WEBHOOK_SECRET=your-strong-random-gumroad-webhook-secret

# ----------------------------------------------------------
# MANUAL PAYMENT SYSTEM (REQUIRED for UPI/Bank billing)
# ----------------------------------------------------------

# Admin secret key — protects /api/v1/admin/* endpoints (payments,
# customer lookups). Fails CLOSED (denies) if unset or under 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Cloudflare Workers AND keep a copy in your password manager
ADMIN_SECRET_KEY=your-strong-random-admin-key-here

# UPI payment details (shown to users in payment instructions)
UPI_ID=cyberdudebivash@upi
UPI_NAME=CYBERDUDEBIVASH SENTINEL

# Bank transfer details (for NEFT/IMPS payments)
BANK_NAME=CYBERDUDEBIVASH TECHNOLOGIES
BANK_ACCOUNT=your-account-number
BANK_IFSC=your-ifsc-code
BANK_LABEL=Your Bank Name

# ----------------------------------------------------------
# RESEND NEWSLETTER (OPTIONAL — production-grade ESP)
# Get from: https://resend.com/api-keys and https://resend.com/audiences
# Powers /api/v1/newsletter + registration welcome email — secret stays
# server-side only. Until set, newsletter signups still work via the
# formsubmit fallback in email-engine.js.
# ----------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=your-audience-id
# Optional — falls back to noreply@cyberdudebivash.com if unset
RESEND_FROM_EMAIL=noreply@cyberdudebivash.com

# ----------------------------------------------------------
# DIGITAL PRODUCT DELIVERY (REQUIRED for signed download links)
# ----------------------------------------------------------

# HMAC key signing/verifying product download tokens. Throws if unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=your-strong-random-download-token-secret

# Optional — falls back to 'cyberdudebivash-products' if unset
PRODUCTS_BUCKET=cyberdudebivash-products

# Cloudflare R2 (S3-compatible) credentials for product file storage.
# NOTE: as of this writing, api/v1/customer/download.js's R2 code path
# requires the `aws-sdk` package, which is NOT a declared dependency —
# this branch is dead code until that's fixed. Setting these alone will
# not make downloads work; see platform/open-issues.md before relying
# on this path in the new deployment.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Alternate (non-R2) AWS S3 credentials — same dead-code caveat above.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ----------------------------------------------------------
# AUTHENTICATED GITHUB DISPATCH (api/cron/dispatch-intel.js)
# Existing GitHub Actions schedules remain authoritative for Blogger.
# Do not configure a second dispatcher or increase cadence implicitly.
# ----------------------------------------------------------

# Bearer secret an authorized scheduler must send to authenticate its call to this
# endpoint. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-strong-random-cron-secret

# Fine-grained GitHub PAT, scoped to Actions:write on this repo only.
# Create at: GitHub → Settings → Developer settings → Fine-grained tokens
GITHUB_DISPATCH_TOKEN=github_pat_...

# Optional — fall back to cyberdudebivash / cyberdudebivash-blog if unset
GITHUB_REPO_OWNER=cyberdudebivash-pvt-ltd
GITHUB_REPO_NAME=cyberdudebivash-blog

# ----------------------------------------------------------
# CONTENT PIPELINE ENRICHMENT (all OPTIONAL — pipelines degrade
# gracefully without any of these; typically set as GitHub Actions
# repository secrets rather than here, since fetch-live-intel.js and
# ai-security-intel-engine.js normally run inside GitHub Actions, not
# as a Cloudflare Worker)
# ----------------------------------------------------------
GITHUB_TOKEN=ghp_...
NVD_API_KEY=your-nvd-api-key
OTX_API_KEY=your-alienvault-otx-key
SENTINEL_APEX_API_KEY=optional-endpoints-are-public
ANTHROPIC_API_KEY=sk-ant-...
AISEC_ANALYST=true

# ----------------------------------------------------------
# CROSS-SERVICE BRIDGE (api/v1/billing.js → intel.cyberdudebivash.com)
# ----------------------------------------------------------

# Optional — falls back to https://intel.cyberdudebivash.com if unset
APEX_API_BASE=https://intel.cyberdudebivash.com

# Optional. If set, outbound calls to APEX_API_BASE are HMAC-signed
# (X-Sentinel-Bridge-Signature). Only takes effect once the receiving
# service is updated to verify it — see api/v1/billing.js's comment at
# the call site. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APEX_BRIDGE_SECRET=your-strong-random-bridge-secret

# ----------------------------------------------------------
# BACKUP & DISASTER RECOVERY (scripts/backup-customer-data.js,
# scripts/restore-customer-data.js — typically a GitHub Actions
# repository secret, not a Worker secret, since the backup workflow
# runs in GitHub Actions)
# ----------------------------------------------------------

# AES key encrypting the Redis customer-data backup snapshot. Both
# scripts hard-exit if this is unset. Store it somewhere durable OUTSIDE
# this repo too — losing it makes every backup made with it permanently
# unrecoverable. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=your-strong-random-backup-encryption-key

# AES-256-GCM key encrypting customer SIEM connector credentials at rest
# in D1 (siem_connectors.credential_ciphertext — Controlled SIEM
# Deployment Gateway v1, api/_lib/connector-crypto.js). Connector
# credential save/rotate/decrypt hard-refuses if this is unset. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_CREDENTIAL_MASTER_KEY=your-strong-random-connector-credential-master-key
# Set only during a master-key rotation window: the PRIOR key, so
# previously-encrypted credentials can still be decrypted until they are
# naturally re-encrypted (credential rotation) under the new current key.
# Remove once nothing references it anymore.
# CONNECTOR_CREDENTIAL_MASTER_KEY_PREVIOUS=your-previous-connector-credential-master-key

# ----------------------------------------------------------
# SITE CONFIG
# ----------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://blog.cyberdudebivash.in

# Do NOT set this to "development" on the Cloudflare Worker's
# production/staging environments. api/_lib/middleware.js has a
# Redis-unavailable dev-auth bypass gated on
# NODE_ENV === 'development' (plus a second required flag,
# ALLOW_DEV_AUTH_BYPASS=true) — leave both unset in production.
# NODE_ENV=production

# ----------------------------------------------------------
# RAZORPAY WEBHOOK SETUP (manual step)
# 1. Go to https://dashboard.razorpay.com/app/webhooks
# 2. Add endpoint: https://blog.cyberdudebivash.in/api/v1/billing/razorpay-webhook
# 3. Select events:
#    - payment.captured
#    - order.paid
# 4. Copy the Webhook Secret → paste as RAZORPAY_WEBHOOK_SECRET above
# ----------------------------------------------------------

